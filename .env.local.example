# Supabase — same project as panelopia.com, so quote requests submitted here
# land in the same `leads` table / CRM dashboard as the main site.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Analytics / Ads — all optional. Leave unset to disable that piece entirely;
# app/GoogleTag.tsx and lib/analytics.ts no-op cleanly when a var is missing.
# Do not fill these with placeholder-looking values "just to have something" —
# an unset var is the correct default until the client has real accounts.

# GA4 property (Admin → Data Streams → Web), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads account tag (Tools → Conversions → "Google tag" section), e.g. AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Only needed if you want a classic Ads conversion fired directly (in addition
# to / independent of a GA4 Key Event imported into Ads). Both must be set
# together — from the specific conversion action's "Tag setup" page.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
